# Firebase web app config (Firebase console → Project settings → Your apps → Web app)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=piq-dashboard.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=piq-dashboard
VITE_FIREBASE_STORAGE_BUCKET=piq-dashboard.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Google account allowed to sign in as Admin (comma-separated for more than one)
VITE_ADMIN_EMAILS=

# --- Team invitation emails (server-only: no VITE_ prefix, so never sent to the browser) ---
# Read by api/send-invite.js. Put them in .env.local for `npm run dev` and in
# Vercel → Project → Settings → Environment Variables for production.
# SMTP_USER: the Snap Infinity Gmail address that sends the invitations
# SMTP_PASS: a Google App Password for that account (Google Account → Security → App passwords)
SMTP_USER=
SMTP_PASS=
# Optional: public site URL for the "Accept invitation" link (defaults to the site the admin is on)
APP_URL=
# Optional overrides (defaults shown)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# MAIL_FROM_NAME=Box Theory
